
03. COUNT OUT-OF-ORDER PAIRS

1. Problem Statement

Count pairs of indices (i, j) such that:

i < j
a[i] > a[j]

Equal values are not counted.

Example:
Input: [2, 4, 1, 3, 5]
Output: 3

The pairs are (2,1), (4,1) and (4,3).

2. Brute-Force Approach

Check every possible pair using two loops.

Code:

#include <iostream>
#include <vector>
using namespace std;

long long countPairsBrute(vector<int>& a) {
    long long count = 0;
    int n = a.size();

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[i] > a[j]) {
                count++;
            }
        }
    }

    return count;
}

Complexity:
Time: O(n^2)
Auxiliary Space: O(1)

3. Optimized Approach: Merge Sort

During merging, both halves are sorted. If a right-half element is smaller than the current left-half element, it is also smaller than all remaining elements in the left half.

We add mid - i + 1 to the count.

Code:

#include <iostream>
#include <vector>
using namespace std;

long long mergeSortCount(vector<int>& a, vector<int>& temp,
                         int left, int right) {
    if (left >= right) {
        return 0;
    }

    int mid = left + (right - left) / 2;

    long long count = 0;

    count += mergeSortCount(a, temp, left, mid);
    count += mergeSortCount(a, temp, mid + 1, right);

    int i = left;
    int j = mid + 1;
    int k = left;

    while (i <= mid && j <= right) {
        if (a[i] <= a[j]) {
            temp[k++] = a[i++];
        } else {
            count += mid - i + 1;
            temp[k++] = a[j++];
        }
    }

    while (i <= mid) {
        temp[k++] = a[i++];
    }

    while (j <= right) {
        temp[k++] = a[j++];
    }

    for (int p = left; p <= right; p++) {
        a[p] = temp[p];
    }

    return count;
}

int main() {
    vector<int> a = {2, 4, 1, 3, 5};
    vector<int> temp(a.size());

    cout << mergeSortCount(a, temp, 0, (int)a.size() - 1);

    return 0;
}

4. Complexity

Time: O(n log n)
Auxiliary Space: O(n), including the temporary array and recursion stack.

5. Edge Cases

[] -> 0
[5] -> 0
[1, 2, 3] -> 0
[3, 2, 1] -> 3
[2, 2, 1] -> 2
